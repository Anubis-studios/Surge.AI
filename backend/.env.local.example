# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (from scripts/stripe-setup.js)
STRIPE_SURGE_COINS_STARTER=price_xxx
STRIPE_SURGE_COINS_CREATOR=price_xxx
STRIPE_SURGE_COINS_PRO=price_xxx
STRIPE_SURGE_COINS_ULTRA=price_xxx

STRIPE_SURGE_BUCKS_SMALL=price_xxx
STRIPE_SURGE_BUCKS_MEDIUM=price_xxx
STRIPE_SURGE_BUCKS_LARGE=price_xxx

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Application URL
APP_URL=http://localhost:3000

# Video Supplier Configuration
SUPPLIER_API_URL=https://api.supplier.com/v1
SUPPLIER_API_KEY=your-supplier-api-key
SUPPLIER_WEBHOOK_SECRET=your-webhook-secret

# Fallback Suppliers
SUPPLIER_FALLBACK_A_URL=https://api.fallback-a.com/v1
SUPPLIER_FALLBACK_A_KEY=your-fallback-a-key

SUPPLIER_FALLBACK_B_URL=https://api.fallback-b.com/v1
SUPPLIER_FALLBACK_B_KEY=your-fallback-b-key

# Costs
VIDEO_COST_BUCKS=3
